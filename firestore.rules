rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to verify user owns the document
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection: user can only read/write their own profile
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Orgs collection: only owner can access
    match /orgs/{orgId} {
      allow read, update, delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
    }

    // Invoices collection: only owner can access
    match /invoices/{invoiceId} {
      allow read, update, delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
    }

    // Notices collection: only owner of invoice/notice can access
    match /notices/{noticeId} {
      allow read, update, delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
    }

    // Calls collection: only owner can access
    match /calls/{callId} {
      allow read, update, delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
    }

    // Audit logs: written server-side only via Admin SDK, client access denied
    match /auditLogs/{logId} {
      allow read, write: if false;
    }
  }
}
